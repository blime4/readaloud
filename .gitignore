# 运行时产物（不进仓库）
cache/
.venv/
__pycache__/
*.pyc

# 本机记录：上次验证可用的 Python 解释器路径
python.path

# 日志
*.log

# 页面构建产物
node_modules/

# 临时探针产物（手工 curl 验证时留下的中间 JSON / 脚本）
_t_*.json
_probe_*.py

# 登录态：这里存的是你自己账号的 cookie，**绝对不能进仓库**
cookies.json
# 「打开登录窗口」用的独立浏览器配置目录
browser-profile/

# 书架里是用户自己的书，只留在本机
books/

# 本地大模型 TTS：权重和虚拟环境都是本机资产，不进仓库
models/
.tts-venv/
# CosyVoice 官方仓库（含 4.1GB 权重），要时按 README 重新 clone
.cosyvoice-src/
